<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
    <!-- Top Bar -->
    <LinearLayout android:id="@+id/top_bar" android:layout_width="0dp" android:layout_height="64dp" android:background="@color/surface"
        android:gravity="center_vertical" android:paddingHorizontal="8dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageButton android:id="@+id/btn_back" android:layout_width="40dp" android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_back" app:tint="@color/primary" android:contentDescription="Back" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"
            android:text="@string/product_details" android:textColor="@color/primary" android:textSize="16sp" android:textStyle="bold" />
        <ImageButton android:id="@+id/btn_cart_top" android:layout_width="40dp" android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_cart" app:tint="@color/primary" android:contentDescription="Cart" />
    </LinearLayout>
    <!-- Content -->
    <ScrollView android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar" app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <ImageView android:id="@+id/iv_product_main" android:layout_width="match_parent" android:layout_height="360dp"
                android:scaleType="centerCrop" android:background="@color/surface_container_lowest" android:contentDescription="Product" />
            <!-- Info Section -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/surface"
                android:orientation="vertical" android:padding="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:id="@+id/tv_product_name" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:textColor="@color/on_surface" android:textSize="22sp" android:textStyle="bold" />
                    <ImageButton android:id="@+id/btn_favorite" android:layout_width="40dp" android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_heart" android:contentDescription="Favorite" />
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical">
                    <TextView android:id="@+id/tv_product_price" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/primary" android:textSize="32sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_original_price" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" android:textColor="@color/outline" android:textSize="12sp" android:visibility="gone" />
                    <TextView android:id="@+id/tv_discount" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" android:background="@color/error_container" android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp" android:textColor="@color/on_error_container" android:textSize="10sp" android:visibility="gone" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="★★★★" android:textColor="@color/star_gold" android:textSize="14sp" />
                    <TextView android:id="@+id/tv_rating" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="4dp" android:textColor="@color/on_surface" android:textSize="12sp" android:textStyle="bold" />
                    <View android:layout_width="1dp" android:layout_height="12dp" android:layout_marginHorizontal="8dp" android:background="@color/outline_variant" />
                    <TextView android:id="@+id/tv_reviews_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                    <View android:layout_width="1dp" android:layout_height="12dp" android:layout_marginHorizontal="8dp" android:background="@color/outline_variant" />
                    <TextView android:id="@+id/tv_sold_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
            <!-- Stock -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:background="@color/surface" android:gravity="center_vertical" android:padding="12dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/free_shipping" android:textColor="@color/on_surface" android:textSize="14sp" />
                <TextView android:id="@+id/tv_stock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:background="@color/surface_container_high" android:paddingHorizontal="12dp" android:paddingVertical="4dp"
                    android:textColor="@color/primary" android:textSize="12sp" />
            </LinearLayout>
            <!-- Description -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:background="@color/surface" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/product_description" android:textColor="@color/on_surface" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_product_desc" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:textColor="@color/on_surface_variant" android:textSize="14sp" android:lineSpacingMultiplier="1.4" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <!-- Bottom Buttons -->
    <LinearLayout android:id="@+id/bottom_bar" android:layout_width="0dp" android:layout_height="80dp" android:background="@color/surface_container"
        android:elevation="8dp" android:gravity="center" android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <Button android:id="@+id/btn_add_to_cart" style="@style/FlashShop.Button.Secondary"
            android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:text="@string/add_to_cart" />
        <Button android:id="@+id/btn_buy_now" style="@style/FlashShop.Button.Primary"
            android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/buy_now" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
